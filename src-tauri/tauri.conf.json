{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inbound Surveillance",
  "version": "0.1.0",
  "identifier": "com.inbound.surveillance",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inbound Surveillance",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "desktop.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/inbound-engine"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "localhost"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
