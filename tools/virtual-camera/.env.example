# Virtual Camera Streamer Configuration

# Web UI port (open http://localhost:8090)
WEB_PORT=8090

# RTSP Stream port (Inbound Surveillance connects to rtsp://localhost:8556/<channel>)
RTSP_PORT=8556

# WebRTC preview port
WEBRTC_PORT=8889

# External host (change to LAN IP if Inbound Surveillance runs on a different machine)
EXTERNAL_HOST=localhost
